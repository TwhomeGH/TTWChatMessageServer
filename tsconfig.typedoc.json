{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "ScriptLib/**/*.cjs",
    "ScriptLib/**/*.mjs",
    "Server.js",
    "TikTok.js"
  ]
}
