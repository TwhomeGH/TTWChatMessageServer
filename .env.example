# TTWChatMessageServer 環境變數範例
# 複製本檔為 .env 後填入你的設定值
# 完整說明請參閱 Docs/envExample

# ─── TikTok ──────────────────────────────────────────
TIKTOK_NAME=coffeelatte0709

# 三種認證方式擇一
# [A] 完整 Cookie（建議）
TIKTOK_COOKIES=fblo_xxx=yyy; sessionid=xxx; tt-target-idc=alisg; ...
# [B] Session ID（舊版相容）
SESSION_ID=你的TikTok SessionID
TT_TARGET_IDC=alisg
# [C] EulerStream API Key（不用 Cookie，走原始簽名服務）
# SIGN_API_KEY=你的EulerStream API Key
# （相容舊寫法 SIGN_API=...）

# ─── Twitch ──────────────────────────────────────────
CLIENT_ID=你的Twitch Client ID
CLIENT_SECRET=你的Twitch Client Secret
TWITCH_USER_NAME=你的Twitch頻道名稱
# 原生事件使用數字 UserID；填入可讓舊場次補分類直接帶入（可從啟動日誌 [Twitch] UserID 取得）
# TWITCH_USER_ID=你的Twitch數字UserID

# ─── Twitch 自動剪輯 (AutoClip) ──────────────────────
# 以頻道自己的近期平均為基準，觀眾數/聊天速率相對平常出現高峰時自動建立剪輯
# score = W_VIEWERS·(觀眾/基準) + W_MSG·(訊息速率/基準)，超過門檻即觸發
# 需同時 isTwitch=1 才生效
# AUTO_CLIP_ENABLED=0
# AUTO_CLIP_W_VIEWERS=0.5
# AUTO_CLIP_W_MSG=0.5
# AUTO_CLIP_SCORE_THRESHOLD=1.8
# AUTO_CLIP_BASELINE_WINDOW_MIN=30
# AUTO_CLIP_RATE_WINDOW_MIN=5
# AUTO_CLIP_WINDOW_MIN=30
# AUTO_CLIP_FLOOR_VIEWERS=2
# AUTO_CLIP_FLOOR_MSG_PER_MIN=0.3
# AUTO_CLIP_COOLDOWN_MIN=15
# AUTO_CLIP_SUSTAIN_MIN=1.5
# AUTO_CLIP_INSTANT_MULTIPLIER=2
# AUTO_CLIP_DEDUP_SEC=10
# AUTO_CLIP_TITLE_PREFIX=人氣高峰

# ─── 自動停止 ──────────────────────────────────────
# 所有支援結束偵測的平台（TikTok／Twitch）都結束後，延遲幾秒自動停止聊天子程序。
# 同時啟用 Kick／Odysee／YouTube 時不會自動停止（目前沒有可靠的結束訊號）。
# AUTO_STOP_ENABLED=0
# AUTO_STOP_GRACE_SEC=60

# ─── Kick ────────────────────────────────────────────
KICK_CLIENT_ID=你的Kick Client ID
KICK_CLIENT_SECRET=你的Kick Client Secret
KICK_USER_NAME=你的Kick頻道名稱
KICK_CHANNEL_ID=你的Kick頻道ID

# ─── Odysee ──────────────────────────────────────────
ODYSEE_CHANNEL_NAME=你的Odysee頻道名稱

# ─── Youtube ─────────────────────────────────────────
YOUTUBE_API_KEY=你的YouTube Data API Key
# 建議填 UC 開頭的頻道 ID；原生會解析 @handle，但人流補分類與比對請用 UC ID。
YOUTUBE_CHANNEL_ID=你的YouTube頻道ID

# 無有效 OAuth 時，用專用瀏覽器讀取實際觀看頁的聊天室（預設啟用；0=關閉）。
YOUTUBE_BROWSER_FALLBACK=1
# 第一次登入／同意可設 0，處理完再改回 1。
YOUTUBE_BROWSER_HEADLESS=1
# 專用 profile 路徑；內含登入 cookie，已在 .gitignore 排除。
YOUTUBE_BROWSER_PROFILE=data/youtube-browser-profile
# 選填：指定 Chrome/Edge 執行檔；未設定時自動偵測。
# YOUTUBE_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ─── 推送 ────────────────────────────────────────────
BARK_API=https://api.day.app/你的Bark Key
NTFY_API=https://ntfy.sh/你的主題
SOCKET_API=http://192.168.0.101:9322
# 額外 socket 端點（選填）：多筆以分號或換行分隔，可用 ?filter=類別 只收指定分類
# SOCKET_APIS=tcp://192.168.0.5:9322?filter=chat,gift;tcp://10.0.0.9:9322

# 贊助廣告管理頁面網址（Bark 通知點擊後開啟）
# SPONSOR_MANAGE_URL=http://你的內網IP:3332/sponsor

# ─── 翻譯 ────────────────────────────────────────────
TRANSLATE_API_URL=https://api.mymemory.translated.net/get
TRANSLATE_SOURCE_LANG=en
TRANSLATE_TARGET_LANG=zh-TW
GIFT_TRANSLATE_PREFILL_LIMIT=10
